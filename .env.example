# Copy this file to ".env" and fill in your values.

# Get this from BotFather. IMPORTANT: if this token was ever shared publicly,
# regenerate it in BotFather (/revoke then /token) and paste the new one here.
BOT_TOKEN=put-your-bot-token-here

# Your Telegram user ID (send /id to the bot to find it). Comma-separated for more.
SUPER_ADMINS=

# Leave empty to use a local SQLite file. To use a remote Postgres database later,
# put its connection string here, e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# Local stats file name (used only when DATABASE_URL is empty).
STATS_DB=chameleon_stats.db

# Minimum players to start a game.
MIN_PLAYERS=3
